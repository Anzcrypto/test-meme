# Public, safe to expose (anon key restricted by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Telegram bot (optional, only if you enable /api/telegram/webhook) ---
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Random string. Sama persis dengan secret_token saat setWebhook.
TELEGRAM_WEBHOOK_SECRET=ganti-string-acak-panjang
# Comma-separated Telegram user IDs yang boleh akses bot via private chat.
# Cek user ID sendiri: chat ke @userinfobot atau forward pesan ke @JsonDumpBot
TELEGRAM_ALLOWED_USER_IDS=123456789
# (Opsional) Comma-separated group/supergroup chat IDs yang boleh pake bot.
# Forward 1 pesan dari group ke @JsonDumpBot untuk dapetin chat ID (negatif, mis. -1001234567890)
TELEGRAM_ALLOWED_CHAT_IDS=
