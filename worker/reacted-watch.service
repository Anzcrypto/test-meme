[Unit]
Description=Reacted Messages Telegram watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust paths to where you cloned the repo on the VPS
WorkingDirectory=/opt/test-meme/worker
EnvironmentFile=/opt/test-meme/worker/.env
ExecStart=/opt/test-meme/worker/venv/bin/python watch.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Run as a non-root user you create, e.g. 'deploy'
User=deploy

[Install]
WantedBy=multi-user.target
