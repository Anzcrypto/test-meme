# From https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Telethon string session (generate once locally with login_helper.py)
TG_SESSION=your_string_session_here

# Channel(s) to sync. Use the username (e.g. @mychannel) or numeric id (e.g. -1001234567890).
# Comma-separated for multiple channels.
TG_CHANNELS=-1001234567890

# How many messages to look back per run (sync window)
SYNC_LIMIT=500

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
